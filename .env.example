# Secrets — copy to .env and edit before production.
# Container listens on :8000 internally; docker-compose publishes it on :8086.
SECRET_KEY=replace-me-with-openssl-rand-hex-32
DATABASE_URL=sqlite:///./data.sqlite
VOICES_DIR=./voices

LOG_LEVEL=INFO
ACCESS_TOKEN_TTL_DAYS=365
PAIRING_CODE_TTL_SECONDS=600
MAX_VOICE_DURATION_SECONDS=60
